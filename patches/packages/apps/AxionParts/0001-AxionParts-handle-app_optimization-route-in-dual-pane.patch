From a669dbb79e71f2021c14d6eabdb79a1665a36bcd Mon Sep 17 00:00:00 2001
From: ami <github@amisuke.com>
Date: Tue, 24 Nov 2026 17:40:37 +0900
Subject: [PATCH] AxionParts: handle app_optimization route in dual-pane
 DetailPaneContent

DetailScreen handled the app_optimization route, but DetailPaneContent used in two-pane/landscape layouts was missing it, causing a blank pane when launching ACTION_APP_OPTIMIZATION directly from notifications.

Change-Id: I9c4f2b8a7e1d6c5a3f0e8b2d4a6c1e9f7b3d5a2e
---
 src/com/android/axion/axionparts/ui/DashboardScreen.kt | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/com/android/axion/axionparts/ui/DashboardScreen.kt b/src/com/android/axion/axionparts/ui/DashboardScreen.kt
index 17923e0..4aff62d 100644
--- a/src/com/android/axion/axionparts/ui/DashboardScreen.kt
+++ b/src/com/android/axion/axionparts/ui/DashboardScreen.kt
@@ -536,6 +536,7 @@ private fun DetailPaneContent(
             )
         "kernel_manager" -> KernelManagerScreen(onBackClick = onClose)
         "ram_plus" -> RamPlusScreen(onBackClick = onClose)
+        "app_optimization" -> AppOptimizationScreen(onBackClick = onClose)
         "app_picker" ->
             ManagedAppPickerScreen(
                 titleRes = appPickerTitleRes,
-- 
2.53.0

