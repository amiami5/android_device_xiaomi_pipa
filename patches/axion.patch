From: SheoranPranshu <sheoranpranshu@gmail.com>
Date: Sat, 23 Aug 2025 09:14:36 +0530
Subject: [PATCH] pipa: Bringup Axion OS

---
 lineage_pipa.mk                               | 15 ++++++++++++---
 .../apps/Settings/res/values/derp_strings.xml | 19 -------------------
 2 files changed, 12 insertions(+), 22 deletions(-)
 delete mode 100644 overlay-lineage/packages/apps/Settings/res/values/derp_strings.xml

diff --git a/lineage_pipa.mk b/lineage_pipa.mk
index f2cdb4b..ab9a85f 100644
--- a/lineage_pipa.mk
+++ b/lineage_pipa.mk
@@ -17,9 +17,18 @@ $(call inherit-product, device/xiaomi/pipa/device.mk)
 # Inherit keys
 $(call inherit-product, vendor/lineage-priv/keys/keys.mk)
 
-# Derpfest
-DERPFEST_BUILD_TYPE := Official
-WITH_GMS := true
+#EPPE
+TARGET_DISABLE_EPPE := true
+
+#Axion Specific
+AXION_CAMERA_REAR_INFO := 13
+AXION_CAMERA_FRONT_INFO := 8
+AXION_CPU_SMALL_CORES := 0,1,2,3
+AXION_CPU_BIG_CORES := 4,5,6,7
+AXION_MAINTAINER := Pranshu Sheoran
+AXION_PROCESSOR := Qualcomm_Snapdragon_870
+BYPASS_CHARGE_SUPPORTED := true
+TARGET_ENABLE_BLUR := true
 
 PRODUCT_NAME := lineage_pipa
 PRODUCT_DEVICE := pipa
diff --git a/overlay-lineage/packages/apps/Settings/res/values/derp_strings.xml b/overlay-lineage/packages/apps/Settings/res/values/derp_strings.xml
deleted file mode 100644
index 16368d1..0000000
