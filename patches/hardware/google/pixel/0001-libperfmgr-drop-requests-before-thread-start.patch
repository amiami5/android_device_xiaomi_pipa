- NodeLooperThread起動前(vendor.powerhal.init待ち)にRequest/Cancelされると
  Jobが消費されずに溜まり続けていた
- vm.max_map_count(65530)に達してpower HALがScudo OOMでabortしていた
- isRunning()でなければ積まずにfalseを返すように変更

Change-Id: Icccd5c34ced1b9853226738419a1b398a787099d
---
 power-libperfmgr/libperfmgr/NodeLooperThread.cc | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/power-libperfmgr/libperfmgr/NodeLooperThread.cc b/power-libperfmgr/libperfmgr/NodeLooperThread.cc
index 78b23c3c..1f9c9253 100644
--- a/power-libperfmgr/libperfmgr/NodeLooperThread.cc
+++ b/power-libperfmgr/libperfmgr/NodeLooperThread.cc
@@ -43,6 +43,11 @@ bool NodeLooperThread::Request(const std::vector<NodeAction>& actions,
         LOG(WARNING) << "NodeLooperThread is exiting";
         return false;
     }
+    // Drop requests until the looper is started, otherwise jobs pile up in
+    // the queue with nobody to consume them and exhaust the process mappings.
+    if (!::android::Thread::isRunning()) {
+        return false;
+    }
 
     Job *job = jobmgr_.getFreeJob();
     job->is_cancel = false;
@@ -68,6 +73,11 @@ bool NodeLooperThread::Cancel(const std::vector<NodeAction>& actions,
         LOG(WARNING) << "NodeLooperThread is exiting";
         return false;
     }
+    // Drop requests until the looper is started, otherwise jobs pile up in
+    // the queue with nobody to consume them and exhaust the process mappings.
+    if (!::android::Thread::isRunning()) {
+        return false;
+    }
 
     Job *job = jobmgr_.getFreeJob();
     job->is_cancel = true;
