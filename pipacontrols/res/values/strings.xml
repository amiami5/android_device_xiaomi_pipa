    <string name="keyboard_switch_title">Keyboard Support</string>
    <string name="keyboard_more_info">Enable this only if you own the Xiaomi Smart Keyboard. When enabled, the system will (hopefully) automatically detect keyboard connection and manage power states. Disabling this saves battery and system resources.\n\nNote: This is separate from Bluetooth keyboards, which work without this setting.</string>
