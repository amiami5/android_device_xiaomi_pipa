<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/pipa_controls_title">

    <PreferenceCategory
        android:key="category_accessories"
        android:title="@string/pipa_category_accessories">

        <Preference
            android:key="pipa_stylus"
            android:title="@string/stylus_title"
            android:summary="@string/stylus_summary" />

        <Preference
            android:key="pipa_keyboard"
            android:title="@string/keyboard_title"
            android:summary="@string/keyboard_summary" />

        <Preference
            android:key="pipa_lid"
            android:title="@string/lid_title"
            android:summary="@string/lid_summary" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_display"
        android:title="@string/pipa_category_display">

        <Preference
            android:key="pipa_refresh_rate"
            android:title="@string/refresh_title"
            android:summary="@string/refresh_summary" />

        <Preference
            android:key="pipa_saturation"
            android:title="@string/saturation_title"
            android:summary="@string/saturation_summary" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_performance"
        android:title="@string/pipa_category_performance">

        <Preference
            android:key="pipa_cpu_governor"
            android:title="@string/cpu_governor_title"
            android:summary="@string/cpu_governor_summary" />

        <Preference
            android:key="pipa_cpu_freq_cap"
            android:title="@string/cpu_freq_cap_title"
            android:summary="@string/cpu_freq_cap_summary" />

        <Preference
            android:key="pipa_gpu_governor"
            android:title="@string/gpu_governor_title"
            android:summary="@string/gpu_governor_summary" />

        <Preference
            android:key="pipa_gpu_freq_cap"
            android:title="@string/gpu_freq_cap_title"
            android:summary="@string/gpu_freq_cap_summary" />

        <Preference
            android:key="pipa_prefer_big_cores"
            android:title="@string/prefer_big_cores_title"
            android:summary="@string/prefer_big_cores_summary" />

        <Preference
            android:key="pipa_core_migration"
            android:title="@string/core_migration_title"
            android:summary="@string/core_migration_summary" />

        <Preference
            android:key="pipa_cpu_ramp_speed"
            android:title="@string/cpu_ramp_speed_title"
            android:summary="@string/cpu_ramp_speed_summary" />

        <Preference
            android:key="pipa_app_priority"
            android:title="@string/app_priority_title"
            android:summary="@string/app_priority_summary" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_touch"
        android:title="@string/pipa_category_touch">

        <Preference
            android:key="pipa_touch_boost"
            android:title="@string/touch_boost_title"
            android:summary="@string/touch_boost_summary" />

        <Preference
            android:key="pipa_big_cores_touch"
            android:title="@string/big_cores_touch_title"
            android:summary="@string/big_cores_touch_summary" />

        <Preference
            android:key="pipa_boost_duration"
            android:title="@string/boost_duration_title"
            android:summary="@string/boost_duration_summary" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_battery"
        android:title="@string/pipa_category_battery">

        <Preference
            android:key="pipa_bypass_charging"
            android:title="@string/bypass_charging_title"
            android:summary="@string/bypass_charging_summary" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_reset"
        android:title="@string/pipa_category_reset">

        <Preference
            android:key="pipa_reset_all"
            android:title="@string/reset_all_title"
            android:summary="@string/reset_all_summary" />

    </PreferenceCategory>

</PreferenceScreen>
