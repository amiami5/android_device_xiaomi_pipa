<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/gpu_freq_cap_title">

    <ListPreference
        android:key="gpu_freq_cap_key"
        android:title="@string/gpu_freq_cap_title"
        android:entries="@array/gpu_freq_cap_entries"
        android:entryValues="@array/gpu_freq_cap_values"
        android:defaultValue="670000000"
        android:persistent="true" />

    <com.android.settingslib.widget.FooterPreference
        android:key="gpu_freq_cap_footer"
        android:title="@string/gpu_freq_cap_footer"
        android:selectable="false" />

</PreferenceScreen>
