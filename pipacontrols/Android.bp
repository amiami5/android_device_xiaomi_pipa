android_app {
    name: "PipaControls",

    defaults: [
        "SettingsLibDefaults",
    ],

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],

    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,

    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
    ],

    required: [
        "xiaomi-pen",
        "xiaomi-keyboard",
    ],
}

cc_binary {
    name: "xiaomi-pen",
    vendor: true,
    srcs: [
        "xiaomi-pen.cpp",
    ],
    shared_libs: [
        "libcutils",
        "liblog",
    ],
}

cc_binary {
    name: "xiaomi-keyboard",
    vendor: true,
    srcs: [
        "xiaomi-keyboard.cpp",
    ],
    shared_libs: [
        "libcutils",
        "liblog",
        "libsensorndkbridge",
    ],
}
