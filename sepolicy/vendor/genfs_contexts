# Bypass Charging
genfscon sysfs /devices/platform/soc/c440000.qcom,spmi/spmi-0/spmi0-02/c440000.qcom,spmi:qcom,pm8150b@2:qcom,qpnp-smb5/power_supply/battery/input_suspend    u:object_r:vendor_sysfs_battery_supply:s0

# CPU Frequency Cap
genfscon sysfs /module/msm_performance/parameters u:object_r:sysfs_msm_performance:s0

# CPU Scheduler sched tunables
genfscon proc /sys/kernel/sched_boost             u:object_r:pipa_sched_proc:s0
genfscon proc /sys/kernel/sched_upmigrate         u:object_r:pipa_sched_proc:s0
genfscon proc /sys/kernel/sched_downmigrate       u:object_r:pipa_sched_proc:s0
genfscon proc /sys/kernel/sched_group_upmigrate   u:object_r:pipa_sched_proc:s0
genfscon proc /sys/kernel/sched_group_downmigrate u:object_r:pipa_sched_proc:s0
